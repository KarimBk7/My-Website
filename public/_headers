/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Astro haengt einen Inhalts-Hash an jeden Dateinamen. Diese Dateien aendern
# sich nie unter derselben Adresse, also duerfen sie dauerhaft im Cache bleiben.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/dokumente/*
  Cache-Control: public, max-age=86400

# Das Seitenverhalten liegt in einer eigenen Datei, weil die Richtlinie oben
# eingebettete Skripte verbietet und Astro kleine Skripte von sich aus
# einbettet.
#
# max-age=0 ist hier Absicht und darf nicht "optimiert" werden. Der Dateiname
# traegt keinen Inhalts-Hash, die HTML wird dagegen bei jedem Aufruf neu geholt.
# Mit einer laengeren Frist bekommt der Besucher neue HTML mit altem Skript --
# die neuen Elemente sind da, aber niemand bedient sie, und nichts schlaegt
# fehl. Genau das ist mit max-age=3600 passiert. Die Datei ist 6 KB; eine
# Rueckfrage je Aufruf kostet nichts, ein stiller Versionsversatz alles.
/js/*
  Cache-Control: public, max-age=0, must-revalidate
