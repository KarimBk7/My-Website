/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Astro haengt einen Inhalts-Hash an jeden Dateinamen. Diese Dateien aendern
# sich nie unter derselben Adresse, also duerfen sie dauerhaft im Cache bleiben.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/dokumente/*
  Cache-Control: public, max-age=86400

# Die Seite laedt kein JavaScript. Falls je wieder Verhalten dazukommt, gehoert
# es in eine eigene Datei unter public/ -- die Richtlinie oben verbietet
# eingebettete Skripte, und Astro bettet kleine Skripte von sich aus ein.
# Dann hier eine kurze Cache-Regel mit Rueckfrage ergaenzen, denn ein
# Dateiname ohne Inhalts-Hash darf nicht dauerhaft im Cache stehen.
