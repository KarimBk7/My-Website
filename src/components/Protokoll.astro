---
import {
  person, pruefstand, stammdaten, stationen, arbeitsfelder, projekte,
  fremdbefunde, ui, type Lang,
} from '../data/inhalt';

/* Bilder bewusst NICHT ueber astro:assets.
   Cloudflare hat dieses Projekt als Worker angelegt und dabei einen Adapter
   eingesetzt, dessen Bilddienst <Image> auf einen Laufzeit-Endpunkt /_image
   umbiegt -- den die statische Auslieferung nicht bedient. Lokal war alles
   gruen, live antworteten alle sieben Bilder mit 404.
   Die Varianten erzeugt jetzt `node tools/bilder.mjs` vorab nach public/media,
   dieses Manifest haelt Groessen und Dateinamen. Damit haengt nichts mehr an
   einer Hosting-Eigenheit, und der Build laesst sich vor dem Deploy pruefen. */
import bilder from '../data/bilder.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (s: Record<Lang, string>) => s[lang];

/** Liefert Quelle, srcset und Naturgroesse eines vorberechneten Bildes. */
const bild = (name: string) => {
  const m = (bilder as Record<string, any>)[name];
  return {
    breite: m.breite,
    hoehe: m.hoehe,
    gross: m.varianten[m.varianten.length - 1].datei,
    srcset: m.varianten.map((v: any) => `${v.datei} ${v.breite}w`).join(', '),
  };
};

const zahl = (n: number) => n.toLocaleString(lang === 'de' ? 'de-DE' : 'en-GB');

/** Zerlegt eine Kennzahl wie "6.400" oder "90+" in Zahl und Suffix, damit das
    Zaehlwerk sie hochlaufen lassen kann. Der sichtbare Text wird aus derselben
    Zahl formatiert, damit Skript und Nicht-Skript dasselbe zeigen. */
const kennzahl = (s: string) => {
  const m = s.match(/^(\d[\d.]*)(\+?)$/);
  return m ? { wert: Number(m[1].replace(/\./g, '')), suffix: m[2] } : null;
};

/* Die GitHub-Marke als gezeichneter Pfad (Octicon mark-github, 16er-Raster).
   Einmal definiert, an beiden Stellen verwendet -- ein Zeichensatz-Symbol
   waere hier fehl am Platz, das Logo muss die echte Form haben. */
const githubMarke =
  'M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z';

/* LinkedIn-Marke im selben 16er-Raster wie die GitHub-Marke, damit beide
   Symbole nebeneinander gleich gross wirken. */
const linkedinMarke =
  'M13.63 13.63h-2.37V9.92c0-.89-.02-2.03-1.24-2.03-1.24 0-1.43.97-1.43 1.97v3.77H6.22V6h2.28v1.04h.03c.32-.6 1.09-1.24 2.25-1.24 2.4 0 2.85 1.58 2.85 3.64v4.19ZM3.55 4.96a1.38 1.38 0 1 1 0-2.76 1.38 1.38 0 0 1 0 2.76Zm1.19 8.67H2.36V6h2.38v7.63ZM14.82 0H1.18C.53 0 0 .52 0 1.16v13.68C0 15.48.53 16 1.18 16h13.64c.65 0 1.18-.52 1.18-1.16V1.16C16 .52 15.47 0 14.82 0Z';

/* Ein Pfeil in eine Ablage -- das uebliche Zeichen fuer "wird gespeichert".
   Steht an jedem Link, der eine Datei herunterlaedt, damit vor dem Klick
   klar ist, dass etwas auf der Platte landet und sich nichts oeffnet. */
const ladeMarke = 'M8 1v8m0 0 3.2-3.2M8 9 4.8 5.8M2 11.5v1.7c0 .44.36.8.8.8h10.4c.44 0 .8-.36.8-.8v-1.7';

/* Aussenlinks oeffnen einen neuen Tab. Als eine Stelle statt an jedem Link
   wiederholt -- so kann keiner davon den Zusatz verlieren. `noopener` haelt
   die neue Seite von window.opener fern. */
const aussen = { target: '_blank', rel: 'noopener' } as const;
const aussenIch = { target: '_blank', rel: 'me noopener' } as const;

const mailto = `mailto:${person.email}?subject=${encodeURIComponent(t(ui.mailBetreff))}`;
const stellen = ['Freie Universität Berlin', 'Projektron GmbH', 'Lesto Branto GmbH', 'LUM GmbH'];

/* Das Inhaltsverzeichnis. Jedes Sprungziel ist eine echte Ueberschrift auf
   der Seite, auch der Elternknoten "Projekte" -- ein Eintrag, der nirgendwohin
   fuehrt, waere der einzige tote Punkt in der Liste. */
type Eintrag = { id: string; label: string; nr?: string; kinder?: Eintrag[] };
const eintraege: Eintrag[] = [
  { id: 'h-felder', label: t(ui.arbeitsfelderTitel) },
  { id: 'h-stamm', label: t(ui.stammdatenTitel) },
  { id: 'h-stationen', label: t(ui.stationenTitel) },
  {
    id: 'h-projekte',
    label: t(ui.projekteTitel),
    kinder: projekte.map((p) => ({ id: `h-${p.id}`, label: t(p.titel), nr: p.nr })),
  },
  { id: 'h-befunde', label: t(ui.fremdbefundeTitel) },
  { id: 'h-freigabe', label: t(ui.freigabeTitel) },
];
---

<header class="kopf">
  <div class="huelle kopf-innen">
    <div>
      <div class="name-zeile">
        <h1 class="titel-gross">{person.nachname},<br />{person.vorname}</h1>
        {/* Beide Profile in einer eigenen Gruppe: untereinander eng, zum Namen
            hin der grosse Abstand der Namenszeile. */}
        <div class="marken-paar">
          <a class="marke-link" href={person.githubUrl} {...aussenIch}
             aria-label={`${t(ui.githubProfil)} — github.com/${person.github} (${t(ui.neuerTab)})`}>
            <svg width="26" height="26" viewBox="0 0 16 16" aria-hidden="true"><path d={githubMarke} fill="currentColor" /></svg>
          </a>
          <a class="marke-link" href={person.linkedinUrl} {...aussenIch}
             aria-label={`${t(ui.linkedinProfil)} (${t(ui.neuerTab)})`}>
            <svg width="24" height="24" viewBox="0 0 16 16" aria-hidden="true"><path d={linkedinMarke} fill="currentColor" /></svg>
          </a>
        </div>
      </div>
      <p class="kopf-zeile" style="margin:1.35rem 0 0;color:#d6e5dd;max-width:46ch">
        {t(ui.kopfText)}
      </p>
    </div>

    <div class="stapel" style="--l:1rem">
      <div class="stempel">
        <p class="feld-name" style="margin:0">{t(ui.freigegebenFuer)}</p>
        <p class="wert" style="margin:0">{t(ui.rolle)}</p>
        {/* Ohne Verfuegbarkeit kann niemand entscheiden, ob die eigene Stelle
            ueberhaupt passt. Sie steht deshalb im Kopf und nicht erst im
            Freigabeblock am Fuss der Seite. */}
        <p class="feld-name stempel-trenner" style="margin:0">{t(ui.verfuegbarTitel)}</p>
        <p class="wert" style="margin:0">{t(ui.verfuegbarWert)}</p>
      </div>
      <div class="kontakt">
        <div class="knopfreihe">
          <a class="knopf" href={mailto} data-kontakt={person.email}>
            {t(ui.kontakt)}
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
              <path d="M2 7.5h11M8.5 3l4.5 4.5L8.5 12" stroke="currentColor" stroke-width="1.8" />
            </svg>
          </a>
          <a class="knopf knopf--rand" href="/dokumente/lebenslauf-abdil-karim-bakir.pdf"
             download aria-label={`${t(ui.lebenslaufPdf)} ${t(ui.herunterladen)}`}>
            {t(ui.lebenslaufPdf)}
            <svg class="lade-marke" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d={ladeMarke} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
        <p class="kontakt-hinweis" role="status" aria-live="polite"></p>
      </div>
    </div>
  </div>
</header>

<div class="streifen">
  <div class="huelle streifen-innen">
    <span class="streifen-feld"><span class="feld-name">{t(ui.pruefling)}</span><span class="wert">{person.nachname}, {person.vorname}</span></span>
    <span class="streifen-feld"><span class="feld-name">{t(ui.protokollNr)}</span><span class="wert">{person.protokollNr}</span></span>
    <span class="streifen-feld"><span class="feld-name">{t(ui.stand)}</span><span class="wert">{person.stand}</span></span>
    <span class="streifen-feld"><span class="feld-name">{t(ui.pruefer)}</span><span class="wert">{stellen.join(' · ')}</span></span>
    <nav class="sprachwahl" aria-label={t(ui.sprache)}>
      <span class="feld-name" style="margin-right:.2rem">{t(ui.sprache)}</span>
      <a href="/" hreflang="de" aria-current={lang === 'de' ? 'true' : undefined}>DE</a>
      <a href="/en/" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
    </nav>
  </div>
</div>

<div class="rumpf">
  {/* Inhaltsverzeichnis. Offen als Vorgabe; das Skript merkt sich die Wahl
      und klappt es auf schmalen Bildschirmen zu. Ohne Skript bleibt es offen. */}
  <aside class="register" id="register" aria-label={t(ui.register)}>
    <div class="register-kopf">
      <button class="klappe" type="button" data-klappe aria-expanded="true" aria-controls="register" aria-label={t(ui.registerZu)}>
        <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true">
          <line x1="1" y1="2" x2="17" y2="2" stroke="currentColor" stroke-width="2" />
          <line x1="1" y1="7" x2="17" y2="7" stroke="currentColor" stroke-width="2" />
          <line x1="1" y1="12" x2="17" y2="12" stroke="currentColor" stroke-width="2" />
        </svg>
      </button>
      <span class="feld-name">{t(ui.register)}</span>
    </div>
    <nav aria-label={t(ui.register)}>
      <ul>
        {eintraege.map((e) => (
          <li class={e.kinder ? 'hat-kinder' : undefined}>
            <a href={`#${e.id}`} data-eintrag={e.id}>{e.label}</a>
            {e.kinder && (
              <ul class="kinder">
                {e.kinder.map((k) => (
                  <li>
                    <a href={`#${k.id}`} data-eintrag={k.id}>
                      <span class="nr">{k.nr}</span>
                      <span class="text">{k.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="register-fuss">
      <a href="/dokumente/lebenslauf-abdil-karim-bakir.pdf" download
         aria-label={`${t(ui.lebenslaufPdf)} ${t(ui.herunterladen)}`}>
        <svg class="lade-marke" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d={ladeMarke} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {t(ui.lebenslaufPdf)}
      </a>
      <a href={mailto}>{t(ui.kontakt)}</a>
      <a href={person.githubUrl} {...aussenIch} aria-label={`github.com/${person.github} (${t(ui.neuerTab)})`}>
        <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><path d={githubMarke} fill="currentColor" /></svg>
        github.com/{person.github}
      </a>
      <a href={person.linkedinUrl} {...aussenIch} aria-label={`${t(ui.linkedinProfil)} (${t(ui.neuerTab)})`}>
        <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><path d={linkedinMarke} fill="currentColor" /></svg>
        LinkedIn
      </a>
    </div>
  </aside>

  <button class="klappe register-griff" type="button" data-klappe aria-expanded="false" aria-controls="register" aria-label={t(ui.registerAuf)}>
    <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true">
      <line x1="1" y1="2" x2="17" y2="2" stroke="currentColor" stroke-width="2" />
      <line x1="1" y1="7" x2="17" y2="7" stroke="currentColor" stroke-width="2" />
      <line x1="1" y1="12" x2="17" y2="12" stroke="currentColor" stroke-width="2" />
    </svg>
  </button>
  <div class="register-schleier" aria-hidden="true"></div>

  <main id="inhalt" class="faden">
    <!-- ---------------------------------------------------- Arbeitsfelder -->
    <section class="abschnitt huelle" aria-labelledby="h-felder">
      <div class="stapel" style="--l:1.25rem">
        <h2 class="titel-abschnitt" id="h-felder">{t(ui.arbeitsfelderTitel)}</h2>
        <div class="felder">
          {arbeitsfelder.map((f) => (
            <div class="aufbau">
              <h3>{t(f.name)}</h3>
              <p>{t(f.beleg)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ------------------------------------------- Stammdaten / Stationen -->
    <section class="abschnitt huelle" aria-labelledby="h-stamm">
      <div class="spalten-2">
        <div class="stapel">
          <h2 class="titel-abschnitt" id="h-stamm">{t(ui.stammdatenTitel)}</h2>
          <div class="gitter">
            {stammdaten.map((f) => (
              <div class="gitter-reihe aufbau">
                <span class="feld-name">{t(f.label)}</span>
                <span>{t(f.wert)}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="stapel">
          <h2 class="titel-abschnitt" id="h-stationen">{t(ui.stationenTitel)}</h2>
          <div class="gitter">
            {stationen.map((s) => (
              <div class="gitter-reihe aufbau">
                <span class="feld-name">{t(s.zeit)}</span>
                <div>
                  <div style="font-variation-settings:'wght' 620">{t(s.rolle)}</div>
                  <div class="messwert" style="font-size:.8125rem;color:var(--gruen);margin:.1rem 0 .35rem">{s.ort}</div>
                  <p class="fliess" style="margin:0;font-size:.9375rem">{t(s.text)}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- -------------------------------------------------------- Projekte -->
    <section class="abschnitt huelle vorspann" aria-labelledby="h-projekte">
      <h2 class="titel-abschnitt" id="h-projekte" style="margin:0">{t(ui.projekteTitel)}</h2>
      <p class="fliess" style="margin:0">{t(ui.projekteText)}</p>
    </section>

    {projekte.map((p) => (
      <section class="abschnitt huelle blatt" aria-labelledby={`h-${p.id}`}>
        <div class="stapel" style="--l:2rem">
          <div class="blatt-kopf">
            <div class="blatt-zeile">
              <span class="blatt-nr">{p.nr}</span>
              {'stempel' in p && p.stempel && (
                <span class="abnahme-stempel" role="img"
                      aria-label={`${t(ui.abnahme)}: ${t(p.stempel.wort)} ${p.stempel.zusatz}`}>
                  <span class="abnahme-wort">{t(p.stempel.wort)}</span>
                  <span class="abnahme-zusatz">{p.stempel.zusatz}</span>
                </span>
              )}
            </div>
            <h3 class="titel-blatt" id={`h-${p.id}`}>{t(p.titel)}</h3>
            <p class="fliess" style="margin:0">{t(p.kurz)}</p>
          </div>

          <div class="gitter">
            {p.kopf.map((f) => (
              <div class="gitter-reihe aufbau">
                <span class="feld-name">{t(f.l)}</span>
                <span>{t(f.w)}</span>
              </div>
            ))}
          </div>

          <div class="spalten-2">
            <div class="stapel" style="--l:.75rem">
              <h4 class="feld-name">{t(ui.aufgabe)}</h4>
              <p class="fliess" style="margin:0">{t(p.aufgabe)}</p>
              {'herausforderung' in p && p.herausforderung && (
                <div style="border-left:1px solid var(--gruen-linie);padding-left:1rem;margin-top:.75rem">
                  <h5 style="font-size:.9375rem">{t(p.herausforderung.titel)}</h5>
                  <p class="fliess" style="margin:.4rem 0 0;font-size:.9375rem">{t(p.herausforderung.text)}</p>
                </div>
              )}
            </div>

            <div class="stapel" style="--l:.75rem">
              <h4 class="feld-name">{t(ui.meinBeitrag)}</h4>
              <ul class="liste">
                {p.beitrag[lang].map((b) => <li class="aufbau"><span></span><span>{b}</span></li>)}
              </ul>
            </div>
          </div>

          {/* Die grosse Zahlenreihe traegt nur dort, wo die Zahlen das Argument
              sind. Viermal wiederholt waere sie das Geruest der Seite. */}
          {p.id === 'spesenkonfigurator' ? (
            <div class="zahlenreihe">
              {p.kennzahlen.map((k) => {
                const n = kennzahl(k.wert);
                return (
                  <div class="aufbau">
                    <div class="zahl" data-zahl={n?.wert} data-suffix={n?.suffix || undefined}>
                      {n ? zahl(n.wert) + n.suffix : k.wert}
                    </div>
                    <div class="zahl-l">{t(k.l)}</div>
                    <div class="zahl-s">{t(k.s)}</div>
                  </div>
                );
              })}
            </div>
          ) : (
            <div class="stapel" style="--l:.6rem">
              <h4 class="feld-name">{t(ui.kennwerte)}</h4>
              <div class="kennwerte">
                {p.kennzahlen.map((k) => {
                  const n = kennzahl(k.wert);
                  return (
                    <div class="aufbau">
                      <span class="w" data-zahl={n?.wert} data-suffix={n?.suffix || undefined}>
                        {n ? zahl(n.wert) + n.suffix : k.wert}
                      </span>
                      <span class="l">{t(k.l)}</span>
                      <span class="s">{t(k.s)}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* Die Messwerte sitzen dort, wo sie hingehoeren: im Projekt, aus dem
              sie stammen. Kurz gehalten -- es geht darum zu zeigen, dass die
              Optimierung stattgefunden hat und belegbar ist. */}
          {p.id === 'spesenkonfigurator' && (
            <div class="stapel" style="--l:.75rem">
              <h4 class="feld-name">{t(ui.performanzTitel)}</h4>
              <p class="fliess" style="margin:0">{t(ui.performanzText)}</p>
              <table class="messtabelle messtabelle--kompakt">
                <thead>
                  <tr>
                    <th scope="col" class="feld-name">{t(ui.pruefpunkt)}</th>
                    <th scope="col" class="feld-name">{t(pruefstand.stufen.vorher)}</th>
                    <th scope="col" class="feld-name">{t(pruefstand.stufen.nachher)}</th>
                  </tr>
                </thead>
                <tbody>
                  {pruefstand.zeilen.map((z) => (
                    <tr class="aufbau">
                      <td>
                        {t(z.label)}
                        <div class="mess-quelle" style="margin-top:.15rem">{t(pruefstand.last)}</div>
                      </td>
                      <td class="messwert">
                        {z.vorher === null ? (
                          <span class="stufe stufe--offen">{t(z.vorherText!)}</span>
                        ) : (
                          <>
                            <span data-zahl={z.vorher}>{zahl(z.vorher)}</span>
                            {z.einheit && <span class="mess-einheit">{z.einheit}</span>}
                          </>
                        )}
                      </td>
                      <td class="messwert" style="font-variation-settings:'wght' 620">
                        <span data-zahl={z.nachher}>{zahl(z.nachher)}</span>
                        {z.einheit && <span class="mess-einheit">{z.einheit}</span>}
                        {z.faktor && <div style="font-size:.75rem;color:var(--gruen);margin-top:.15rem">{t(ui.faktor)} {z.faktor}</div>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="mess-quelle" style="margin:.25rem 0 0" set:html={t(ui.messmethode)} />
            </div>
          )}

          {/* Der Beleg zum groessten Messwert: erst die Schichtmessung, die
              zeigt WO die Zeit lag, dann der Quelltext davor und danach. Ohne
              den Code bleibt der Faktor 34 eine Behauptung. */}
          {'eingriff' in p && p.eingriff && (
            <div class="stapel" style="--l:.75rem">
              <h4 class="feld-name">{t(p.eingriff.titel)}</h4>
              <p class="fliess" style="margin:0">{t(p.eingriff.text)}</p>

              <div class="schichten" aria-hidden="true">
                {p.eingriff.schichten.map((s) => (
                  <div class="schicht aufbau" style={`--f:${s.ms / 5051}`}>
                    <span class="schicht-l">{t(s.l)}</span>
                    <span class="schicht-balken"><span></span></span>
                    <span class="schicht-w">{zahl(s.ms)} ms</span>
                  </div>
                ))}
              </div>
              <p class="mess-quelle" style="margin:0">{t(p.eingriff.schichtHinweis)}</p>

              <div class="codepaar">
                <figure class="aufbau">
                  <figcaption><span class="marke-vorher">{t(ui.eingriffVorher)}</span></figcaption>
                  <pre><code>{p.eingriff.vorher}</code></pre>
                </figure>
                <figure class="aufbau">
                  <figcaption><span class="marke-nachher">{t(ui.eingriffNachher)}</span></figcaption>
                  <pre><code>{p.eingriff.nachher}</code></pre>
                </figure>
              </div>
              <p class="mess-quelle" style="margin:0">
                {p.eingriff.datei} · {t(ui.eingriffCommit)} <span class="messwert">{p.eingriff.commit}</span>
              </p>
            </div>
          )}

          {'bilder' in p && p.bilder && (
            <div class="bildreihe">
              {p.bilder.map((b) => (
                <figure
                  class="aufbau"
                  data-breit={'breit' in b && b.breit ? '' : undefined}
                  style={`--nativ:${bild(b.datei).breite}px`}
                >
                  {/* Ein <a> auf die Bilddatei, kein <button>: ohne Skript
                      oeffnet der Link das Bild in voller Groesse in einem
                      neuen Tab. Mit Skript faengt register.js den Klick ab
                      und zeigt es in der Lupe. */}
                  <a class="bild-lupe" href={bild(b.datei).gross} target="_blank" rel="noopener"
                     data-lupe data-bu={t(b.bu)}
                     data-w={bild(b.datei).breite} data-h={bild(b.datei).hoehe}
                     aria-label={`${t(ui.bildVergroessern)}: ${t(b.bu)}`}>
                    <img
                      src={bild(b.datei).gross}
                      srcset={bild(b.datei).srcset}
                      sizes={'breit' in b && b.breit
                        ? '(max-width: 52rem) 92vw, 72rem'
                        : '(max-width: 52rem) 92vw, 30vw'}
                      width={bild(b.datei).breite}
                      height={bild(b.datei).hoehe}
                      alt={t(b.bu)}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="lupe-marke" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <circle cx="7" cy="7" r="4.7" stroke="currentColor" stroke-width="1.6" />
                        <path d="M10.4 10.4 14 14M5.2 7h3.6M7 5.2v3.6" stroke="currentColor"
                              stroke-width="1.6" stroke-linecap="round" />
                      </svg>
                    </span>
                  </a>
                  <figcaption>{t(b.bu)}</figcaption>
                </figure>
              ))}
            </div>
          )}

          {'maengel' in p && p.maengel && (
            <div class="maengel">
              <h4 class="titel-blatt" style="font-size:1.125rem">{t(p.maengel.titel)}</h4>
              <p class="fliess" style="margin:.5rem 0 1rem;color:var(--tinte-2)">{t(p.maengel.hinweis)}</p>
              <ul class="liste">
                {p.maengel.punkte[lang].map((m) => <li class="aufbau"><span></span><span>{m}</span></li>)}
              </ul>
            </div>
          )}

          {'themen' in p && p.themen && (
            <div class="stapel" style="--l:.75rem">
              <h4 class="feld-name">{t(ui.themenlandkarte)}</h4>
              <div class="landkarte">
                {p.themen.map((g) => (
                  <div class="aufbau">
                    <h5>{t(g.gruppe)} <span>{g.punkte.length}</span></h5>
                    <ul>{g.punkte.map((x) => <li>{x}</li>)}</ul>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="spalten-2">
            <div class="stapel" style="--l:.6rem">
              <h4 class="feld-name">{t(ui.werkzeuge)}</h4>
              <ul class="marken">{p.stack.map((s) => <li>{s}</li>)}</ul>
            </div>
            <div class="stapel" style="--l:.6rem">
              {'auslieferung' in p && p.auslieferung && (
                <>
                  <h4 class="feld-name">{t(ui.auslieferung)}</h4>
                  <p class="fliess" style="margin:0;font-size:.9375rem">{t(p.auslieferung)}</p>
                </>
              )}
              <h4 class="feld-name">{t(ui.einordnung)}</h4>
              <p class="fliess" style="margin:0;font-size:.9375rem">{t(p.einordnung)}</p>
              {'repo' in p && p.repo && (
                <p style="margin:0"><a class="messwert" style="font-size:.8125rem" href={p.repo} {...aussen}
                  aria-label={`${p.repo.replace('https://', '')} (${t(ui.neuerTab)})`}>{p.repo.replace('https://', '')}</a></p>
              )}
            </div>
          </div>
        </div>
      </section>
    ))}

    <!-- ----------------------------------------------------- Fremdbefunde -->
    <section class="abschnitt huelle" aria-labelledby="h-befunde">
      <div class="stapel" style="--l:1.75rem">
        <div class="stapel" style="--l:.75rem">
          <h2 class="titel-abschnitt" id="h-befunde">{t(ui.fremdbefundeTitel)}</h2>
          <p class="fliess">{t(ui.fremdbefundeText)}</p>
        </div>
        {/* Die beiden Karten teilen sich dieselben Zeilen (subgrid): Zitate,
            Quellenzeile, Knopf stehen dadurch auf gleicher Hoehe, auch wenn
            die Zitate unterschiedlich lang sind. */}
        <div class="befunde">
          {fremdbefunde.map((f) => (
            <div class="befund aufbau">
              <div class="zitate">
                {f.zitate[lang].map((z) => <blockquote>{z}</blockquote>)}
              </div>
              <div class="gitter-reihe" style="border:0;padding-bottom:0">
                <span class="feld-name">{t(ui.quelle)}</span>
                <span>
                  <span style="font-variation-settings:'wght' 620">{f.quelle}</span>
                  <span style="color:var(--tinte-3)"> · {t(f.rolle)}</span>
                </span>
              </div>
              <a class="knopf knopf--rand" href={f.datei} style="color:var(--gruen-tief)"
                 download aria-label={`${f.quelle} — ${t(ui.pdfOeffnen)}`}>
                {t(ui.pdfOeffnen)}
                <svg class="lade-marke" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d={ladeMarke} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</div>

{/* Bildlupe. Ein natives <dialog>: Fokusfalle, Escape und der abdunkelnde
    Hintergrund kommen vom Browser, nicht aus nachgebautem JavaScript. Steht
    leer im HTML und wird erst beim Klick befuellt -- so laedt die grosse
    Fassung nur, wenn sie jemand sehen will. */}
<dialog class="lupe" id="lupe" aria-label={t(ui.bildAnsicht)}>
  <form method="dialog" class="lupe-schliessen-form">
    <button class="lupe-schliessen" type="submit" aria-label={t(ui.bildSchliessen)}>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
  </form>
  {/* Ohne <img>-Platzhalter: register.js legt das Bild beim Oeffnen an und
      entfernt es beim Schliessen wieder. Ein mitgeliefertes <img> ohne src
      waere dauerhaft ein Bild, das keines laedt -- und haette die drei
      Bildwaechter (schuss.mjs, live.mjs) gezwungen, genau diesen Fall
      auszunehmen. Lieber den Fall vermeiden als die Pruefung abstumpfen. */}
  <figure class="lupe-figur">
    <figcaption>
      <span class="lupe-bu"></span>
      <span class="lupe-mass feld-name"></span>
    </figcaption>
  </figure>
</dialog>

<!-- ---------------------------------------------------------- Freigabe -->
<footer class="freigabe">
  <div class="huelle abschnitt">
    <div class="spalten-2">
      <div class="stapel">
        <h2 class="titel-abschnitt" id="h-freigabe">{t(ui.freigabeTitel)}</h2>
        <p class="fliess" style="color:#d6e5dd">{t(ui.freigabeText)}</p>
        <div class="kontakt">
          <div style="display:flex;flex-wrap:wrap;gap:.75rem">
            <a class="knopf" href={mailto} data-kontakt={person.email}>{person.email}</a>
            <a class="knopf knopf--rand" href="/dokumente/lebenslauf-abdil-karim-bakir.pdf"
               download aria-label={`${t(ui.lebenslaufPdf)} ${t(ui.herunterladen)}`}>
              {t(ui.lebenslaufPdf)}
              <svg class="lade-marke" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d={ladeMarke} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
          <p class="kontakt-hinweis" role="status" aria-live="polite"></p>
        </div>
      </div>
      <div class="gitter" style="border-top-color:rgba(255,255,255,.3)">
        <div class="gitter-reihe" style="border-bottom-color:rgba(255,255,255,.25)">
          <span class="feld-name">GitHub</span>
          <a href={person.githubUrl} {...aussenIch}
             aria-label={`github.com/${person.github} (${t(ui.neuerTab)})`}>github.com/{person.github}</a>
        </div>
        <div class="gitter-reihe" style="border-bottom-color:rgba(255,255,255,.25)">
          <span class="feld-name">LinkedIn</span>
          <a href={person.linkedinUrl} {...aussenIch}
             aria-label={`${t(ui.linkedinProfil)} (${t(ui.neuerTab)})`}>{person.linkedinUrl.replace('https://www.', '')}</a>
        </div>
        <div class="gitter-reihe" style="border-bottom-color:rgba(255,255,255,.25)">
          <span class="feld-name">{t(ui.standort)}</span>
          <span>{t(ui.standortWert)}</span>
        </div>
        <div class="gitter-reihe" style="border-bottom-color:rgba(255,255,255,.25)">
          <span class="feld-name">{t(ui.stand)}</span>
          <span class="messwert">{person.stand}</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<div class="huelle fuss">
  <p style="margin:0">{t(ui.fussnote)}</p>
</div>

<script type="module" src="/js/register.js" is:inline></script>
