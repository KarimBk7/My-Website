---
import Basis from '../layouts/Basis.astro';
import Rechtsseite from '../components/Rechtsseite.astro';
import Datenschutz from '../components/Datenschutz.astro';
const pfade = { de: '/datenschutz/', en: '/en/privacy/' };
---

<Basis lang="de" pfade={pfade}
       titel="Datenschutzerklärung — Abdil Karim Bakir"
       beschreibung="Welche Daten beim Besuch dieser Bewerbungsseite verarbeitet werden: keine Cookies, kein Tracking, Auslieferung über Cloudflare.">
  <Rechtsseite lang="de" pfade={pfade}>
    <Datenschutz lang="de" />
  </Rechtsseite>
</Basis>
